# ============================================================================
#  Anonimal — imagen LITE (solo motor regex, sin modelo de ML).
#  Liviana (decenas de MB), arranca al instante, sin RAM extra. Detecta datos
#  estructurados (mail, telefono, tarjeta, DNI, CUIT, CBU, secrets) pero NO
#  nombres/direcciones libres (para eso, la imagen full).
# ============================================================================
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ANONIMAL_ENGINE=lite

WORKDIR /app

# upgrade: parches de seguridad de Debian sobre la base (p. ej. zlib1g, CVE-2026-85091).
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# WITH_CRYPTO=1 suma `cryptography` (necesaria SOLO si ANONIMAL_AUTH_MODE=federado, para
# verificar los JWT RS256 del hub). Default 0 = imagen lite pura (modo local, sin la dep).
ARG WITH_CRYPTO=0

COPY requirements.txt .
# Actualizar la toolchain de empaquetado (pip/setuptools/wheel) baja CVEs HIGH
# que arrastra el base image en herramientas de build.
RUN pip install --upgrade pip setuptools wheel \
 && pip install -r requirements.txt \
 && if [ "$WITH_CRYPTO" = "1" ]; then pip install "cryptography>=42"; fi

RUN useradd -m -u 10001 anon
USER anon

COPY anonimal_lite/ ./anonimal_lite/
COPY app/ ./app/
# Versión (pyproject.toml) y novedades (CHANGELOG): el cartel de arranque y la UI las leen de acá.
COPY pyproject.toml CHANGELOG.md ./

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || exit 1

# Lo PRIMERO que se ve en los registros (EasyPanel): versión y qué cambia. Nunca frena el arranque.
CMD ["sh", "-c", "python -m app.novedades; exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
